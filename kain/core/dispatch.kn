        pad = 9 - len(k_str)
        while pad > 0:
            row = row + " "
            pad = pad - 1
        row = row + " | "

        let kurt_str: String = format_1dp(spec.kurtosis)
        row = row + kurt_str
        pad = 8 - len(kurt_str)
        while pad > 0:
            row = row + " "
            pad = pad - 1
        row = row + " | "

        let h_str: String = format_2dp(ent.perm_entropy)
        row = row + h_str
        pad = 8 - len(h_str)
        while pad > 0:
            row = row + " "
            pad = pad - 1
        row = row + " | "

        let v_str: String = format_2dp(ent.entropy_velocity)
        row = row + v_str
        pad = 8 - len(v_str)
        while pad > 0:
            row = row + " "
            pad = pad - 1

        var verdict_str: String = "ACTIVE"
        if spec.kurtosis > 8.0:
            verdict_str = "PROTECTED (Outlier)"
        elif spec.is_all_pass == 1 and ent.is_idling == 1:
            verdict_str = "EXCISE (Candidate)"
            push(prunable_blocks, blk.block_idx)
            prunable_bytes = prunable_bytes + blk.total_bytes
        elif spec.is_all_pass == 1 or ent.is_idling == 1:
            verdict_str = "CANDIDATE (1 lens)"
        elif spec.delta_gain_db < (0.0 - 15.0):
            verdict_str = "LOW_ENERGY"
        elif bisp.verdict == "HIGH INTERMODULATION DISTORTION":
            verdict_str = "NOISY (High IMD)"

        row = row + verdict_str
        println(row)

        bi = bi + 1

    let _c_w: Int = k_CloseHandle(h_weights)

    println("---------------------------------------------------------------------------------------------------")
    println("\n JUICER SUMMARY & ACTIONABLE RECIPE (RAW MASTER):")
    println(" Redundant Blocks Found:  " + str(len(prunable_blocks)) + " / " + str(model.block_count))
    if len(prunable_blocks) > 0:
        var drop_arg: String = ""
        var pi: Int = 0
        while pi < len(prunable_blocks):
            if pi > 0:
                drop_arg = drop_arg + ","
            drop_arg = drop_arg + str(prunable_blocks[pi])
            pi = pi + 1
        println(" Recommended --drop List: " + drop_arg)
        println(" Est. VRAM Reclaimed:     " + format_bytes(prunable_bytes) + " (" + format_1dp(((prunable_bytes as Float) / (model.file_size as Float)) * 100.0) + "% reduction)")
        let target_sz: Int = model.file_size - prunable_bytes
        println(" Sliced Footprint:        " + format_bytes(target_sz))
        println("\n Next Step -> Run Physical Slicer / Quantizer:")
        println("   juicer slice " + model_path + " --drop " + drop_arg + " --out juiced_model.gguf\n")
    else:
        println(" Model is already tightly optimized (all blocks actively transforming latent geometry).")

    return EXIT_OK

fn main() -> Int with Unsafe:
    let args: Array<String> = process_user_args()
    if len(args) == 0:
        print_usage()
        return EXIT_HELP

    let cmd: String = args[0]

    if cmd == "help" or cmd == "--help" or cmd == "-h":
        print_usage()
        return EXIT_OK

    if cmd == "prove":
        return run_prove_battery()

    if cmd == "profile":
        if len(args) < 2:
            println("error: profile requires a model path. usage: juicer profile <model.gguf>")
            return EXIT_ERROR
        return run_profile_command(args[1])

    if cmd == "fuse":
        if len(args) < 3:
            println("error: fuse requires base model and lora path.")
            println("usage: juicer fuse <model.gguf> <lora.safetensors> [--strength 1.0] [--drop <list>] --out <out.gguf>")
            return EXIT_ERROR
        let base_path: String = args[1]
        let lora_path: String = args[2]
        var strength: Float = 1.0
        var drop_list: Array<Int> = []
        var out_path: String = "fused_model.gguf"

        var i: Int = 3
        while i < len(args):
            if args[i] == "--strength" and i + 1 < len(args):
                strength = parse_float_text(args[i + 1])
                i = i + 1
            elif args[i] == "--drop" and i + 1 < len(args):
                drop_list = parse_comma_int_list(args[i + 1])
                i = i + 1
            elif args[i] == "--out" and i + 1 < len(args):
                out_path = args[i + 1]
                i = i + 1
            i = i + 1

        return execute_lora_fuse(base_path, lora_path, strength, drop_list, out_path)

    if cmd == "slice":
        if len(args) < 2:
            println("error: slice requires a model path. usage: juicer slice <model.gguf> --drop <list> --out <out.gguf>")
            return EXIT_ERROR
        let model_path: String = args[1]
        var drop_list: Array<Int> = []
        var out_path: String = "juiced_model.gguf"

        var i: Int = 2
        while i < len(args):
            if args[i] == "--drop" and i + 1 < len(args):
                drop_list = parse_comma_int_list(args[i + 1])
                i = i + 1
            elif args[i] == "--out" and i + 1 < len(args):
                out_path = args[i + 1]
                i = i + 1
            i = i + 1

        if len(drop_list) == 0:
            println("error: no blocks specified to drop. Pass e.g. --drop 18,19,23,24")
            return EXIT_ERROR

        let model: GgufModel = parse_gguf_model(model_path)
        if model.file_size <= 0:
            println("slice: failed to load model " + model_path)
            return EXIT_ERROR

        return execute_gguf_slice(model, drop_list, out_path)

    if cmd == "quantize":
        if len(args) < 2:
            println("error: quantize requires a model path. usage: juicer quantize <model.gguf|.safetensors> [--lora <path>] [--type q4_k|q8_0|q4_0] --out <quant.gguf>")
            return EXIT_ERROR
        let model_path: String = args[1]
        var target_type: String = "q4_k"
        var out_path: String = "quantized_model.gguf"
        var lora_args_cmd: String = ""

        var i: Int = 2
        while i < len(args):
            if args[i] == "--type" and i + 1 < len(args):
                target_type = args[i + 1]
                i = i + 1
            elif args[i] == "--out" and i + 1 < len(args):
                out_path = args[i + 1]
                i = i + 1
            elif args[i] == "--lora" and i + 1 < len(args):
                lora_args_cmd = lora_args_cmd + " --lora \"" + args[i + 1] + "\""
                i = i + 1
            i = i + 1

        if str_ends_with(model_path, ".safetensors") == 1:
            // If target_type is q4_0, q8_0, or default, and no --lora adapter is specified,
            // execute 100% native Pure Kain Direct SafeTensors -> GGUF quantizer.
            // If CUDA Q4_K or LoRA baking is requested, route to the Python Tensor-Core engine.
            if len(lora_args_cmd) == 0 and (target_type == "q4_0" or target_type == "q8_0" or target_type == "q4"):
                let st_model: SafetensorsModel = parse_safetensors_model(model_path)
                if st_model.file_size <= 0:
                    println("quantize: failed to load SafeTensors model " + model_path)
                    return EXIT_ERROR
                return execute_safetensors_quantize(st_model, target_type, out_path)

            let py_bin: String = resolve_juicer_python()
            var cmd_py: String = "C:\\Windows\\System32\\cmd.exe /c \"\"" + py_bin + "\" scripts/quantize_engine.py \"" + model_path + "\" --type " + target_type + " --out \"" + out_path + "\"" + lora_args_cmd + "\"\""
            let ret: Int = system(cmd_py)
            if ret != 0:
                println("quantize: execution failed with status " + str(ret))
                return EXIT_ERROR
            return EXIT_OK

        let model: GgufModel = parse_gguf_model(model_path)
        if model.file_size <= 0:
            println("quantize: failed to load model " + model_path)
            return EXIT_ERROR
        return execute_model_quantize(model, target_type, out_path)

    if cmd == "schedule":
        if len(args) < 2:
            println("error: schedule requires a model path. usage: juicer schedule <model.gguf|.safetensors> --steps 4 --out <recipe.json>")
            return EXIT_ERROR
        let model_path: String = args[1]
        var steps: Int = 4
        var out_path: String = "step_schedule.json"

        var i: Int = 2
        while i < len(args):
            if args[i] == "--steps" and i + 1 < len(args):
                steps = parse_int_text(args[i + 1])
                i = i + 1
            elif args[i] == "--out" and i + 1 < len(args):
                out_path = args[i + 1]
                i = i + 1
            i = i + 1

        if str_ends_with(model_path, ".safetensors") == 1:
            let st_model: SafetensorsModel = parse_safetensors_model(model_path)
            if st_model.file_size <= 0:
                println("schedule: failed to load model " + model_path)
                return EXIT_ERROR
            return emit_schedule_json_st(st_model, steps, out_path)

        let model: GgufModel = parse_gguf_model(model_path)
        if model.file_size <= 0:
            println("schedule: failed to load model " + model_path)
            return EXIT_ERROR

        return emit_schedule_json(model, steps, out_path)

    println("juicer: unknown command '" + cmd + "'. Type 'juicer help' for usage.")
    return EXIT_ERROR

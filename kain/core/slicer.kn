// ============================================================================
// slicer.kn — Physical Zero-Copy GGUF Layer Slicing & Topology Rewriter
//
// Excises redundant / all-pass Transformer blocks from GGUF files:
//   1. Filters excised block tensors
//   2. Re-indexes surviving blocks contiguously (e.g. blocks 0..N-1)
//   3. Rewrites GGUF header & tensor directory
//   4. Streams surviving tensor byte payloads at NVMe DMA line rates (~4-5 GB/s)
// ============================================================================

use std::runtime
use std::text
use std::bytes

pub fn is_block_dropped(block_idx: Int, drop_list: Array<Int>) -> Int:
    var i: Int = 0
    while i < len(drop_list):
        if drop_list[i] == block_idx:
            return 1
        i = i + 1
    return 0

pub fn compute_new_block_index(old_idx: Int, drop_list: Array<Int>) -> Int:
    if is_block_dropped(old_idx, drop_list) == 1:
        return -1
    var drops_before: Int = 0
    var i: Int = 0
    while i < len(drop_list):
        if drop_list[i] < old_idx:
            drops_before = drops_before + 1
        i = i + 1
    return old_idx - drops_before

pub fn reindex_tensor_name(orig_name: String, drop_list: Array<Int>) -> String:
    if str_starts_with(orig_name, "blocks.") == 1:
        let dot2: Int = find_from(orig_name, ".", 7)
        if dot2 > 7:
            let num_str: String = text_substring_string(orig_name, 7, dot2 - 7)
            let old_id: Int = parse_int_text(num_str)
            let new_id: Int = compute_new_block_index(old_id, drop_list)
            let rest: String = text_substring_string(orig_name, dot2, len(orig_name) - dot2)
            return "blocks." + str(new_id) + rest
    elif str_starts_with(orig_name, "double_blocks.") == 1:
        let dot2: Int = find_from(orig_name, ".", 14)
        if dot2 > 14:
            let num_str: String = text_substring_string(orig_name, 14, dot2 - 14)
            let old_id: Int = parse_int_text(num_str)
            var drops_before: Int = 0
            var di: Int = 0
            while di < len(drop_list):
                if drop_list[di] < 1000 and drop_list[di] < old_id:
                    drops_before = drops_before + 1
                di = di + 1
            let new_id: Int = old_id - drops_before
            let rest: String = text_substring_string(orig_name, dot2, len(orig_name) - dot2)
            return "double_blocks." + str(new_id) + rest
    elif str_starts_with(orig_name, "single_blocks.") == 1:
        let dot2: Int = find_from(orig_name, ".", 14)
        if dot2 > 14:
            let num_str: String = text_substring_string(orig_name, 14, dot2 - 14)
            let old_id: Int = parse_int_text(num_str)
            let old_full: Int = old_id + 1000
            var drops_before: Int = 0
            var di: Int = 0
            while di < len(drop_list):
                if drop_list[di] >= 1000 and drop_list[di] < old_full:
                    drops_before = drops_before + 1
                di = di + 1
            let new_id: Int = old_id - drops_before
            let rest: String = text_substring_string(orig_name, dot2, len(orig_name) - dot2)
            return "single_blocks." + str(new_id) + rest
    elif str_starts_with(orig_name, "blk.") == 1:
        let dot2: Int = find_from(orig_name, ".", 4)
        if dot2 > 4:
            let num_str: String = text_substring_string(orig_name, 4, dot2 - 4)
            let old_id: Int = parse_int_text(num_str)
            let new_id: Int = compute_new_block_index(old_id, drop_list)
            let rest: String = text_substring_string(orig_name, dot2, len(orig_name) - dot2)
            return "blk." + str(new_id) + rest
    elif str_starts_with(orig_name, "layers.") == 1:
        let dot2: Int = find_from(orig_name, ".", 7)
        if dot2 > 7:
            let num_str: String = text_substring_string(orig_name, 7, dot2 - 7)
            let old_id: Int = parse_int_text(num_str)
            let new_id: Int = compute_new_block_index(old_id, drop_list)
            let rest: String = text_substring_string(orig_name, dot2, len(orig_name) - dot2)
            return "layers." + str(new_id) + rest
    return orig_name

pub fn patch_kv_block_count(kv_buf: ptr<Byte>, kv_total_len: Int, kv_count: Int, new_block_count: Int) -> Int with Unsafe:
    var cur_off: Int = 24
    var kv_i: Int = 0
    var patched_count: Int = 0

    while kv_i < kv_count:
        if cur_off + 16 > kv_total_len:
            return patched_count

        let klen: Int = read_u64_le(kv_buf, cur_off)
        cur_off = cur_off + 8

        if cur_off + klen + 4 > kv_total_len:
            return patched_count

        // Check if key ends with ".block_count" (12 bytes)
        var is_block_count: Int = 0
        if klen >= 12:
            let k_start: Int = cur_off + klen - 12
            if bref(kv_buf, k_start) == 46:
                if bref(kv_buf, k_start + 1) == 98:
                    if bref(kv_buf, k_start + 2) == 108:
                        if bref(kv_buf, k_start + 3) == 111:
                            if bref(kv_buf, k_start + 4) == 99:
                                if bref(kv_buf, k_start + 5) == 107:
                                    if bref(kv_buf, k_start + 6) == 95:
                                        if bref(kv_buf, k_start + 7) == 99:
                                            if bref(kv_buf, k_start + 8) == 111:
                                                if bref(kv_buf, k_start + 9) == 117:
                                                    if bref(kv_buf, k_start + 10) == 110:
                                                        if bref(kv_buf, k_start + 11) == 116:
                                                            is_block_count = 1

        let val_type: Int = read_u32_le(kv_buf, cur_off + klen)
        let val_off: Int = cur_off + klen + 4

        if is_block_count == 1:
            if val_type == 4 or val_type == 5:
                let old_val: Int = read_u32_le(kv_buf, val_off)
                write_u32_le(kv_buf, val_off, new_block_count)
                println(" Slicer: patched *.block_count KV from " + str(old_val) + " to " + str(new_block_count))
                patched_count = patched_count + 1
            elif val_type == 10 or val_type == 11:
                let old_val64: Int = read_u64_le(kv_buf, val_off)
                write_u64_le(kv_buf, val_off, new_block_count)
                println(" Slicer: patched *.block_count KV from " + str(old_val64) + " to " + str(new_block_count))
                patched_count = patched_count + 1

        // Advance past value based on type
        if val_type == 0 or val_type == 1 or val_type == 7:
            cur_off = val_off + 1
        elif val_type == 2 or val_type == 3:
            cur_off = val_off + 2
        elif val_type == 4 or val_type == 5 or val_type == 6:
            cur_off = val_off + 4
        elif val_type == 8:
            if val_off + 8 > kv_total_len:
                return patched_count
            let slen: Int = read_u64_le(kv_buf, val_off)
            cur_off = val_off + 8 + slen
        elif val_type == 10 or val_type == 11 or val_type == 12:
            cur_off = val_off + 8
        elif val_type == 9:
            if val_off + 12 > kv_total_len:
                return patched_count
            let item_type: Int = read_u32_le(kv_buf, val_off)
            let arr_count: Int = read_u64_le(kv_buf, val_off + 4)
            if item_type == 0 or item_type == 1 or item_type == 7:
                cur_off = val_off + 12 + arr_count
            elif item_type == 2 or item_type == 3:
                cur_off = val_off + 12 + arr_count * 2
            elif item_type == 4 or item_type == 5 or item_type == 6:
                cur_off = val_off + 12 + arr_count * 4
            elif item_type == 10 or item_type == 11 or item_type == 12:
                cur_off = val_off + 12 + arr_count * 8
            elif item_type == 8:
                var elem_off: Int = val_off + 12
                var ai: Int = 0
                while ai < arr_count:
                    if elem_off + 8 > kv_total_len:
                        return patched_count
                    let elem_len: Int = read_u64_le(kv_buf, elem_off)
                    elem_off = elem_off + 8 + elem_len
                    ai = ai + 1
                cur_off = elem_off
            else:
                return patched_count
        else:
            return patched_count

        kv_i = kv_i + 1

    return patched_count

pub fn execute_gguf_slice(model: GgufModel, drop_list: Array<Int>, out_path: String) -> Int with Unsafe:
    println("\n================================================================================")
    println(" juicer.kn — Physical GGUF Slicing Engine")
    println("================================================================================")
    println(" Source:       " + model.path + " (" + format_bytes(model.file_size) + ")")
    println(" Output:       " + out_path)
    println(" Target drops: " + str(len(drop_list)) + " blocks")

    // Filter surviving tensors
    var surviving_tensors: Array<GgufTensor> = []
    var dropped_tensor_count: Int = 0
    var dropped_bytes: Int = 0

    var ti: Int = 0
    while ti < len(model.tensors):
        let t: GgufTensor = model.tensors[ti]
        if t.block_idx >= 0 and is_block_dropped(t.block_idx, drop_list) == 1:
            dropped_tensor_count = dropped_tensor_count + 1
            dropped_bytes = dropped_bytes + t.size_bytes
        else:
            let new_name: String = reindex_tensor_name(t.name, drop_list)
            var new_b_idx: Int = -1
            if t.block_idx >= 0:
                new_b_idx = compute_new_block_index(t.block_idx, drop_list)
            let new_t = GgufTensor {
                name: new_name,
                n_dims: t.n_dims,
                dim0: t.dim0,
                dim1: t.dim1,
                dim2: t.dim2,
                dim3: t.dim3,
                type_id: t.type_id,
                offset: 0, // recomputed below
                size_bytes: t.size_bytes,
                block_idx: new_b_idx,
            }
            push(surviving_tensors, new_t)
        ti = ti + 1

    println(" Dropped:      " + str(dropped_tensor_count) + " tensors (" + format_bytes(dropped_bytes) + ")")
    println(" Surviving:    " + str(len(surviving_tensors)) + " tensors")

    // Open source file for reading
    let h_src: ptr<Void> = k_open_read(model.path)
    if k_handle_bad(h_src) == 1:
        println("slicer: failed to open source model " + model.path)
        return EXIT_ERROR

    // Open destination file for writing
    let h_dst: ptr<Void> = k_open_write(out_path)
    if k_handle_bad(h_dst) == 1:
        println("slicer: failed to open destination file " + out_path)
        let _c: Int = k_CloseHandle(h_src)
        return EXIT_ERROR

    let nslot: ptr<Int> = alloc_zeroed(1, "Int")

    // Read original GGUF header + KV metadata block directly (exact bytes)
    let kv_total_len: Int = model.kv_data_offset
    let kv_buf: ptr<Byte> = alloc_zeroed(kv_total_len + 32, "Byte")
    let r_kv: Int = k_read_at(h_src, nslot, 0, kv_buf, kv_total_len)
    // Update tensor count in header (offset 8 in GGUF header) - single 64-bit store (bytes 8..15)
    let st_cnt: Int = len(surviving_tensors)
    mem_store(ptr_offset(kv_buf, 8, "Byte"), st_cnt, "Int")

    // Update *.block_count in KV metadata section
    var new_b_cnt: Int = model.block_count - len(drop_list)
    if new_b_cnt < 0:
        new_b_cnt = 0
    let _p_kv: Int = patch_kv_block_count(kv_buf, kv_total_len, model.kv_count, new_b_cnt)

    // Write original header + KVs with updated tensor count to destination
    let _w_kv: Int = k_write_all(h_dst, nslot, kv_buf, kv_total_len)
    decay kv_buf

    // Serialize new tensor descriptors
    let t_buf_sz: Int = 1048576 * 4 // 4MB buffer for tensor directory
    let t_buf: ptr<Byte> = alloc_zeroed(t_buf_sz + 32, "Byte")
    var tb_off: Int = 0

    // Assign new continuous offsets aligned to model.alignment
    var cur_payload_offset: Int = 0
    var st_i: Int = 0
    while st_i < len(surviving_tensors):
        let st: GgufTensor = surviving_tensors[st_i]
        let tname: String = st.name
        let tname_bytes: Array<Int> = bytes_of_str(tname)
        let tn_len: Int = len(tname_bytes)

        // Write name length + string
        write_u64_le(t_buf, tb_off, tn_len)
        tb_off = tb_off + 8
        var ni: Int = 0
        while ni < tn_len:
            bstore(t_buf, tb_off, tname_bytes[ni])
            tb_off = tb_off + 1
            ni = ni + 1

        // Write n_dims
        write_u32_le(t_buf, tb_off, st.n_dims)
        tb_off = tb_off + 4

        // Write dims
        if st.n_dims >= 1:
            write_u64_le(t_buf, tb_off, st.dim0)
            tb_off = tb_off + 8
        if st.n_dims >= 2:
            write_u64_le(t_buf, tb_off, st.dim1)
            tb_off = tb_off + 8
        if st.n_dims >= 3:
            write_u64_le(t_buf, tb_off, st.dim2)
            tb_off = tb_off + 8
        if st.n_dims >= 4:
            write_u64_le(t_buf, tb_off, st.dim3)
            tb_off = tb_off + 8

        // Write type_id
        write_u32_le(t_buf, tb_off, st.type_id)
        tb_off = tb_off + 4

        // Write offset
        write_u64_le(t_buf, tb_off, cur_payload_offset)
        tb_off = tb_off + 8

        // Advance payload offset aligned to model.alignment
        cur_payload_offset = cur_payload_offset + st.size_bytes
        let rem: Int = cur_payload_offset % model.alignment
        if rem != 0:
            cur_payload_offset = cur_payload_offset + (model.alignment - rem)

        st_i = st_i + 1

    // Write tensor descriptors buffer to file
    let _w_t: Int = k_write_all(h_dst, nslot, t_buf, tb_off)
    decay t_buf

    // Align file position to model.alignment
    let total_header_written: Int = kv_total_len + tb_off
    let pad_needed: Int = (model.alignment - (total_header_written % model.alignment)) % model.alignment
    if pad_needed > 0:
        let pad_buf: ptr<Byte> = alloc_zeroed(64, "Byte")
        let _w_pad: Int = k_write_all(h_dst, nslot, pad_buf, pad_needed)
        decay pad_buf

    println(" Header & Tensor Directory written (" + format_bytes(total_header_written + pad_needed) + ")")
    println(" Streaming surviving payloads via direct DMA ...")

    // Stream surviving payloads in 8MB DMA chunks
    let chunk_size: Int = 8388608 // 8MB
    let dma_buf: ptr<Byte> = alloc_zeroed(chunk_size + 32, "Byte")
    var bytes_streamed: Int = 0

    var stream_i: Int = 0
    while stream_i < len(model.tensors):
        let orig_t: GgufTensor = model.tensors[stream_i]
        // If surviving
        if orig_t.block_idx < 0 or is_block_dropped(orig_t.block_idx, drop_list) == 0:
            let src_abs_off: Int = model.tensor_data_offset + orig_t.offset
            var remaining: Int = orig_t.size_bytes
            var cur_chunk_src: Int = src_abs_off

            while remaining > 0:
                var to_read: Int = remaining
                if to_read > chunk_size:
                    to_read = chunk_size
                let r_act: Int = k_read_at(h_src, nslot, cur_chunk_src, dma_buf, to_read)
                if r_act > 0:
                    let _w_act: Int = k_write_all(h_dst, nslot, dma_buf, r_act)
                    cur_chunk_src = cur_chunk_src + r_act
                    remaining = remaining - r_act
                    bytes_streamed = bytes_streamed + r_act
                else:
                    break

            // Pad to alignment if needed
            let pad_rem: Int = orig_t.size_bytes % model.alignment
            if pad_rem != 0:
                let align_pad: Int = model.alignment - pad_rem
                let zpad: ptr<Byte> = alloc_zeroed(64, "Byte")
                let _w_zp: Int = k_write_all(h_dst, nslot, zpad, align_pad)
                decay zpad

        stream_i = stream_i + 1

    decay dma_buf
    decay nslot
    let _c_src: Int = k_CloseHandle(h_src)
    let _c_dst: Int = k_CloseHandle(h_dst)

    let final_sz: Int = total_header_written + pad_needed + bytes_streamed
    println(" Slicing COMPLETE!")
    println(" Emitted: " + out_path + " (" + format_bytes(final_sz) + ")")
    let saved: Int = model.file_size - final_sz
    println(" Space reclaimed: " + format_bytes(saved) + " (" + format_1dp(((saved as Float) / (model.file_size as Float)) * 100.0) + "% smaller)")
    println(" Ready to load in ComfyUI, Ollama, LM Studio, or llama.cpp!\n")

    return EXIT_OK

// ============================================================================
// heal — Loader-safe residual healing via downstream norm folding.
// No new tensors: patch the first surviving block's entrance norm gain by
//   alpha = min(1.25, max(1.0, sqrt(1 + sum(RMS_dropped^2))))
// Name matching is substring-based (Wan attn_norm / Flux norm1 / modulation).
// ============================================================================

pub fn is_heal_target_tensor(name: String, target_block_idx: Int) -> Int:
    let b_idx: Int = parse_block_index_from_name(name)
    if b_idx != target_block_idx:
        return 0
    if find_from(name, "input_scale", 0) >= 0:
        return 0
    if find_from(name, "weight_scale", 0) >= 0:
        return 0
    if find_from(name, "attn_norm", 0) >= 0:
        if find_from(name, "weight", 0) >= 0:
            return 1
        return 0
    if find_from(name, "norm1", 0) >= 0:
        if find_from(name, "weight", 0) >= 0:
            return 1
        return 0
    if find_from(name, "modulation", 0) >= 0:
        if find_from(name, "weight", 0) >= 0:
            return 1
        return 0
    if find_from(name, "key_norm", 0) >= 0:
        if find_from(name, "scale", 0) >= 0:
            return 1
        return 0
    if find_from(name, "query_norm", 0) >= 0:
        if find_from(name, "scale", 0) >= 0:
            return 1
        return 0
    return 0

pub fn compute_residual_healing_scale(dropped_blocks: Array<Int>, stats_list: Array<BlockDenseStats>) -> Float:
    var sum_energy: Float = 0.0
    var di: Int = 0
    while di < len(dropped_blocks):
        let b_id: Int = dropped_blocks[di]
        var si: Int = 0
        while si < len(stats_list):
            if stats_list[si].block_idx == b_id:
                let rms: Float = stats_list[si].rms_energy
                sum_energy = sum_energy + (rms * rms)
                break
            si = si + 1
        di = di + 1
    var heal_factor: Float = math_sqrt(1.0 + sum_energy)
    if heal_factor > 1.25:
        heal_factor = 1.25
    if heal_factor < 1.0:
        heal_factor = 1.0
    return heal_factor

pub fn execute_gguf_slice_with_heal(model: GgufModel, drop_list: Array<Int>, out_path: String, heal_flag: Int) -> Int with Unsafe:
    var alpha_heal: Float = 1.0
    var first_surviving: Int = -1
    var heal_stats: Array<BlockDenseStats> = []
    if heal_flag == 1:
        let h_w: ptr<Void> = k_open_read(model.path)
        if k_handle_bad(h_w) == 0:
            var bi: Int = 0
            while bi < len(model.blocks):
                let blk: GgufBlock = model.blocks[bi]
                if is_block_dropped(blk.block_idx, drop_list) == 1:
                    let ds: BlockDenseStats = compute_gguf_block_dense_stats(h_w, model, blk.block_idx, 256)
                    push(heal_stats, ds)
                if is_block_dropped(blk.block_idx, drop_list) == 0:
                    if blk.block_idx >= 0:
                        if first_surviving < 0 or blk.block_idx < first_surviving:
                            var is_downstream: Int = 0
                            var dj: Int = 0
                            while dj < len(drop_list):
                                if blk.block_idx > drop_list[dj]:
                                    is_downstream = 1
                                dj = dj + 1
                            if is_downstream == 1:
                                if first_surviving < 0 or blk.block_idx < first_surviving:
                                    first_surviving = blk.block_idx
                bi = bi + 1
            let _cw: Int = k_CloseHandle(h_w)
        alpha_heal = compute_residual_healing_scale(drop_list, heal_stats)
        println(" Heal: alpha=" + format_2dp(alpha_heal) + " first_surviving=" + str(first_surviving))
        if first_surviving < 0:
            println(" Heal: no downstream block found, healing disabled")
            alpha_heal = 1.0
    var surviving_tensors: Array<GgufTensor> = []
    var dropped_tensor_count: Int = 0
    var dropped_bytes: Int = 0
    var ti: Int = 0
    while ti < len(model.tensors):
        let t: GgufTensor = model.tensors[ti]
        if t.block_idx >= 0 and is_block_dropped(t.block_idx, drop_list) == 1:
            dropped_tensor_count = dropped_tensor_count + 1
            dropped_bytes = dropped_bytes + t.size_bytes
        else:
            let new_name: String = reindex_tensor_name(t.name, drop_list)
            var new_b_idx: Int = -1
            if t.block_idx >= 0:
                new_b_idx = compute_new_block_index(t.block_idx, drop_list)
            let new_t = GgufTensor {
                name: new_name,
                n_dims: t.n_dims,
                dim0: t.dim0,
                dim1: t.dim1,
                dim2: t.dim2,
                dim3: t.dim3,
                type_id: t.type_id,
                offset: 0,
                size_bytes: t.size_bytes,
                block_idx: new_b_idx,
            }
            push(surviving_tensors, new_t)
        ti = ti + 1
    println("\n================================================================================")
    println(" juicer.kn — Physical GGUF Slicing Engine" + " (heal=" + str(heal_flag) + ")")
    println("================================================================================")
    println(" Source:       " + model.path + " (" + format_bytes(model.file_size) + ")")
    println(" Output:       " + out_path)
    println(" Target drops: " + str(len(drop_list)) + " blocks")
    println(" Dropped:      " + str(dropped_tensor_count) + " tensors (" + format_bytes(dropped_bytes) + ")")
    println(" Surviving:    " + str(len(surviving_tensors)) + " tensors")
    let h_src: ptr<Void> = k_open_read(model.path)
    if k_handle_bad(h_src) == 1:
        println("slicer: failed to open source model " + model.path)
        return EXIT_ERROR
    let h_dst: ptr<Void> = k_open_write(out_path)
    if k_handle_bad(h_dst) == 1:
        println("slicer: failed to open destination file " + out_path)
        let _c: Int = k_CloseHandle(h_src)
        return EXIT_ERROR
    let nslot: ptr<Int> = alloc_zeroed(1, "Int")
    let kv_total_len: Int = model.kv_data_offset
    let kv_buf: ptr<Byte> = alloc_zeroed(kv_total_len + 32, "Byte")
    let r_kv: Int = k_read_at(h_src, nslot, 0, kv_buf, kv_total_len)
    let st_cnt: Int = len(surviving_tensors)
    mem_store(ptr_offset(kv_buf, 8, "Byte"), st_cnt, "Int")
    var new_b_cnt: Int = model.block_count - len(drop_list)
    if new_b_cnt < 0:
        new_b_cnt = 0
    let _p_kv: Int = patch_kv_block_count(kv_buf, kv_total_len, model.kv_count, new_b_cnt)
    let _w_kv: Int = k_write_all(h_dst, nslot, kv_buf, kv_total_len)
    decay kv_buf
    let t_buf_sz: Int = 1048576 * 4
    let t_buf: ptr<Byte> = alloc_zeroed(t_buf_sz + 32, "Byte")
    var tb_off: Int = 0
    var cur_payload_offset: Int = 0
    var st_i: Int = 0
    while st_i < len(surviving_tensors):
        let st: GgufTensor = surviving_tensors[st_i]
        let tname_bytes: Array<Int> = bytes_of_str(st.name)
        let tn_len: Int = len(tname_bytes)
        write_u64_le(t_buf, tb_off, tn_len)
        tb_off = tb_off + 8
        var ni: Int = 0
        while ni < tn_len:
            bstore(t_buf, tb_off, tname_bytes[ni])
            tb_off = tb_off + 1
            ni = ni + 1
        write_u32_le(t_buf, tb_off, st.n_dims)
        tb_off = tb_off + 4
        if st.n_dims >= 1:
            write_u64_le(t_buf, tb_off, st.dim0)
            tb_off = tb_off + 8
        if st.n_dims >= 2:
            write_u64_le(t_buf, tb_off, st.dim1)
            tb_off = tb_off + 8
        if st.n_dims >= 3:
            write_u64_le(t_buf, tb_off, st.dim2)
            tb_off = tb_off + 8
        if st.n_dims >= 4:
            write_u64_le(t_buf, tb_off, st.dim3)
            tb_off = tb_off + 8
        write_u32_le(t_buf, tb_off, st.type_id)
        tb_off = tb_off + 4
        write_u64_le(t_buf, tb_off, cur_payload_offset)
        tb_off = tb_off + 8
        cur_payload_offset = cur_payload_offset + st.size_bytes
        let rem: Int = cur_payload_offset % model.alignment
        if rem != 0:
            cur_payload_offset = cur_payload_offset + (model.alignment - rem)
        st_i = st_i + 1
    let _w_t: Int = k_write_all(h_dst, nslot, t_buf, tb_off)
    decay t_buf
    let total_header_written: Int = kv_total_len + tb_off
    let pad_needed: Int = (model.alignment - (total_header_written % model.alignment)) % model.alignment
    if pad_needed > 0:
        let pad_buf: ptr<Byte> = alloc_zeroed(64, "Byte")
        let _w_pad: Int = k_write_all(h_dst, nslot, pad_buf, pad_needed)
        decay pad_buf
    println(" Header & Tensor Directory written (" + format_bytes(total_header_written + pad_needed) + ")")
    println(" Streaming surviving payloads via direct DMA ...")
    let chunk_size: Int = 8388608
    let dma_buf: ptr<Byte> = alloc_zeroed(chunk_size + 32, "Byte")
    var bytes_streamed: Int = 0
    var heal_armed: Int = 0
    if heal_flag == 1:
        if alpha_heal > 1.000001:
            if first_surviving >= 0:
                heal_armed = 1
    var heal_applied: Int = 0
    var stream_i: Int = 0
    while stream_i < len(model.tensors):
        let orig_t: GgufTensor = model.tensors[stream_i]
        if orig_t.block_idx < 0 or is_block_dropped(orig_t.block_idx, drop_list) == 0:
            let src_abs_off: Int = model.tensor_data_offset + orig_t.offset
            var remaining: Int = orig_t.size_bytes
            var cur_chunk_src: Int = src_abs_off
            var is_heal_hit: Int = 0
            if heal_armed == 1:
                if is_heal_target_tensor(orig_t.name, first_surviving) == 1:
                    if orig_t.size_bytes <= chunk_size:
                        if orig_t.type_id == 0 or orig_t.type_id == 1 or orig_t.type_id == 28:
                            is_heal_hit = 1
            while remaining > 0:
                var to_read: Int = remaining
                if to_read > chunk_size:
                    to_read = chunk_size
                let r_act: Int = k_read_at(h_src, nslot, cur_chunk_src, dma_buf, to_read)
                if r_act > 0:
                    if is_heal_hit == 1:
                        if orig_t.type_id == 0:
                            let n_f: Int = r_act / 4
                            var fi: Int = 0
                            while fi < n_f:
                                let fval: Float = read_f32_le(dma_buf, fi * 4) * alpha_heal
                                write_f32_le(dma_buf, fi * 4, fval)
                                fi = fi + 1
                        elif orig_t.type_id == 1:
                            let n_h: Int = r_act / 2
                            var fi: Int = 0
                            while fi < n_h:
                                let u16v: Int = read_u16_le(dma_buf, fi * 2)
                                let fval: Float = fp16_to_fp32(u16v) * alpha_heal
                                write_u16_le(dma_buf, fi * 2, fp32_to_fp16(fval))
                                fi = fi + 1
                        else:
                            let n_h: Int = r_act / 2
                            var fi: Int = 0
                            while fi < n_h:
                                let u16v: Int = read_u16_le(dma_buf, fi * 2)
                                let fval: Float = bf16_to_fp32(u16v) * alpha_heal
                                let bits32: Int = f32_to_bits(fval)
                                write_u16_le(dma_buf, fi * 2, (bits32 >> 16) & 65535)
                                fi = fi + 1
                        heal_applied = 1
                        println(" Heal applied: " + orig_t.name)
                        is_heal_hit = 0
                    let _w_act: Int = k_write_all(h_dst, nslot, dma_buf, r_act)
                    cur_chunk_src = cur_chunk_src + r_act
                    remaining = remaining - r_act
                    bytes_streamed = bytes_streamed + r_act
                else:
                    break
            let pad_rem: Int = orig_t.size_bytes % model.alignment
            if pad_rem != 0:
                let align_pad: Int = model.alignment - pad_rem
                let zpad: ptr<Byte> = alloc_zeroed(64, "Byte")
                let _w_zp: Int = k_write_all(h_dst, nslot, zpad, align_pad)
                decay zpad
        stream_i = stream_i + 1
    decay dma_buf
    decay nslot
    let _c_src: Int = k_CloseHandle(h_src)
    let _c_dst: Int = k_CloseHandle(h_dst)
    let final_sz: Int = total_header_written + pad_needed + bytes_streamed
    println(" Slicing COMPLETE!")
    println(" Emitted: " + out_path + " (" + format_bytes(final_sz) + ")")
    let saved: Int = model.file_size - final_sz
    println(" Space reclaimed: " + format_bytes(saved) + " (" + format_1dp(((saved as Float) / (model.file_size as Float)) * 100.0) + "% smaller)")
    if heal_flag == 1:
        if heal_applied == 1:
            println(" Heal: downstream norm folded (alpha=" + format_2dp(alpha_heal) + ")")
        else:
            println(" Heal: WARNING no matching norm tensor found, emitted unhealed")
    println(" Ready to load in ComfyUI, Ollama, LM Studio, or llama.cpp!\n")
    return EXIT_OK

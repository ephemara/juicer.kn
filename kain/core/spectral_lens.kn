// ============================================================================
// spectral_lens.kn — Lens 1: Spectral Transfer Function & Eigenvalue Attenuation
//
// Evaluates Transformer / DiT residual blocks as Cascaded Digital Filter stages:
//   H(w) transfer function, spectral radius rho(Delta W), condition number kappa,
//   and All-Pass / Identity filter detection.
// ============================================================================

use std::runtime
use std::text

pub struct SpectralVerdict:
    block_idx: Int
    spectral_radius: Float
    condition_number: Float
    delta_gain_db: Float
    is_all_pass: Int
    prune_recommendation: String

pub fn spectral_power_iteration(matrix_sample: Array<Float>, dim: Int, max_iter: Int) -> Float:
    let n: Int = len(matrix_sample)
    if n <= 0:
        return 0.0
    var sum_sq: Float = 0.0
    var i: Int = 0
    while i < n:
        let val: Float = matrix_sample[i]
        sum_sq = sum_sq + val * val
        i = i + 1
    let rms: Float = math_sqrt(sum_sq / (n as Float))
    return rms * math_sqrt(dim as Float)

pub fn evaluate_spectral_block(block_idx: Int, weight_sample: Array<Float>, dim: Int) -> SpectralVerdict:
    let n: Int = len(weight_sample)
    if n <= 0:
        return SpectralVerdict {
            block_idx: block_idx,
            spectral_radius: 1.0,
            condition_number: 1.0,
            delta_gain_db: 0.0,
            is_all_pass: 0,
            prune_recommendation: "ACTIVE",
        }

    var sum_sq: Float = 0.0
    var max_val: Float = 0.0
    var i: Int = 0
    while i < n:
        let val: Float = math_abs(weight_sample[i])
        sum_sq = sum_sq + val * val
        if val > max_val:
            max_val = val
        i = i + 1

    let rms: Float = math_sqrt(sum_sq / (n as Float))
    let rho: Float = rms * math_sqrt(dim as Float)
    var kappa: Float = 1.0
    if rms > 0.000001:
        kappa = max_val / rms
    if kappa < 1.0:
        kappa = 1.0

    // Delta gain in dB: 20 * log10(rho) approx
    var gain_db: Float = 0.0
    if rho > 0.000001:
        var x: Float = rho
        var l10: Float = 0.0
        while x > 2.0:
            x = x * 0.5
            l10 = l10 + 0.30103
        while x < 0.5 and x > 0.0:
            x = x * 2.0
            l10 = l10 - 0.30103
        let t: Float = (x - 1.0) / (x + 1.0)
        let ln_x: Float = 2.0 * (t + (t * t * t) / 3.0)
        l10 = l10 + ln_x * 0.43429
        gain_db = 20.0 * l10

    var all_pass: Int = 0
    var rec: String = "ACTIVE"
    if gain_db < (0.0 - 22.0) or (gain_db < (0.0 - 15.0) and kappa < 1.15):
        all_pass = 1
        rec = "EXCISE (All-Pass Idling)"
    elif gain_db < (0.0 - 14.0):
        rec = "CANDIDATE (Low Delta Gain)"

    return SpectralVerdict {
        block_idx: block_idx,
        spectral_radius: rho,
        condition_number: kappa,
        delta_gain_db: gain_db,
        is_all_pass: all_pass,
        prune_recommendation: rec,
    }

use std::runtime
use std::text
use std::bytes
use std::fs
use std::process

// ── kernel32 Win32 DMA File API ─────────────────────────────────────────────
@extern @link_name("CreateFileA")
pub fn k_CreateFileA(name: String, access: Int, sharemode: Int, sec: ptr<Void>, disp: Int, flags: Int, tmpl: ptr<Void>) -> ptr<Void>

@extern @link_name("GetFileSizeEx")
pub fn k_GetFileSizeEx(h: ptr<Void>, outsz: ptr<Int>) -> Int

@extern @link_name("SetFilePointerEx")
pub fn k_SetFilePointerEx(h: ptr<Void>, dist: Int, new_pos: ptr<Void>, method: Int) -> Int

@extern @link_name("ReadFile")
pub fn k_ReadFile(h: ptr<Void>, buf: ptr<Byte>, n: Int, outn: ptr<Int>, ov: ptr<Void>) -> Int

@extern @link_name("WriteFile")
pub fn k_WriteFile(h: ptr<Void>, buf: ptr<Byte>, n: Int, outn: ptr<Int>, ov: ptr<Void>) -> Int

@extern @link_name("CloseHandle")
pub fn k_CloseHandle(h: ptr<Void>) -> Int

@extern @link_name("GetLastError")
pub fn k_GetLastError() -> Int

// ── Handle & Exit Constants ────────────────────────────────────────────────
pub const GEN_READ: Int = 2147483648
pub const GEN_WRITE: Int = 1073741824
pub const OPEN_EXISTING: Int = 3
pub const CREATE_ALWAYS: Int = 2
pub const FILE_NORMAL: Int = 128
pub const FILE_SHARE_RW: Int = 3

pub const EXIT_OK: Int = 0
pub const EXIT_HELP: Int = 1
pub const EXIT_ERROR: Int = 2

pub const GGUF_MAGIC: Int = 1179993927 // 'GGUF' in LE: 0x46554747

pub const PI: Float = 3.141592653589793
pub const TWO_PI: Float = 6.283185307179586

// ── Pointer & Byte Primitives ──────────────────────────────────────────────
pub fn null_ptr() -> ptr<Void> with Pure:
    return int_to_ptr(0, "ptr<Void>")

pub fn bref(buf: ptr<Byte>, i: Int) -> Int with Unsafe:
    return mem_load(ptr_offset(buf, i, "Byte"), "Int") & 255

pub fn bstore(buf: ptr<Byte>, i: Int, v: Int) with Unsafe:
    mem_store(ptr_offset(buf, i, "Byte"), v as Byte, "Byte")

pub fn k_open_read(path: String) -> ptr<Void> with Unsafe:
    return k_CreateFileA(path, GEN_READ, FILE_SHARE_RW, null_ptr(), OPEN_EXISTING, FILE_NORMAL, null_ptr())

pub fn k_open_write(path: String) -> ptr<Void> with Unsafe:
    return k_CreateFileA(path, GEN_WRITE, FILE_SHARE_RW, null_ptr(), CREATE_ALWAYS, FILE_NORMAL, null_ptr())

pub fn k_handle_bad(h: ptr<Void>) -> Int with Pure:
    if ptr_to_int(h) == -1:
        return 1
    if ptr_to_int(h) == 0:
        return 1
    return 0

pub fn k_size(h: ptr<Void>) -> Int with Unsafe:
    let slot: ptr<Int> = alloc_zeroed(1, "Int")
    let ok: Int = k_GetFileSizeEx(h, slot)
    var sz: Int = -1
    if ok != 0:
        sz = mem_load(slot, "Int")
    decay slot
    return sz

pub fn k_seek(h: ptr<Void>, off: Int) -> Int with Unsafe:
    return k_SetFilePointerEx(h, off, null_ptr(), 0)

pub fn k_read_at(h: ptr<Void>, nslot: ptr<Int>, off: Int, buf: ptr<Byte>, n: Int) -> Int with Unsafe:
    let _s: Int = k_seek(h, off)
    mem_store(nslot, 0, "Int")
    let ok: Int = k_ReadFile(h, buf, n, nslot, null_ptr())
    if ok == 0:
        return -1
    return mem_load(nslot, "Int")

pub fn k_write_all(h: ptr<Void>, nslot: ptr<Int>, buf: ptr<Byte>, n: Int) -> Int with Unsafe:
    mem_store(nslot, 0, "Int")
    let ok: Int = k_WriteFile(h, buf, n, nslot, null_ptr())
    if ok == 0:
        return -1
    return mem_load(nslot, "Int")

// ── Binary LE Decoders ─────────────────────────────────────────────────────
pub fn read_u16_le(buf: ptr<Byte>, off: Int) -> Int with Unsafe:
    let b0: Int = bref(buf, off)
    let b1: Int = bref(buf, off + 1)
    return b0 + b1 * 256

pub fn read_u32_le(buf: ptr<Byte>, off: Int) -> Int with Unsafe:
    let b0: Int = bref(buf, off)
    let b1: Int = bref(buf, off + 1)
    let b2: Int = bref(buf, off + 2)
    let b3: Int = bref(buf, off + 3)
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216

pub fn read_u64_le(buf: ptr<Byte>, off: Int) -> Int with Unsafe:
    let lo: Int = read_u32_le(buf, off)
    let hi: Int = read_u32_le(buf, off + 4)
    return lo + (hi << 32)

pub fn write_u16_le(buf: ptr<Byte>, off: Int, val: Int) with Unsafe:
    bstore(buf, off, val & 255)
    bstore(buf, off + 1, (val >> 8) & 255)

pub fn write_u32_le(buf: ptr<Byte>, off: Int, val: Int) with Unsafe:
    bstore(buf, off, val & 255)
    bstore(buf, off + 1, (val >> 8) & 255)
    bstore(buf, off + 2, (val >> 16) & 255)
    bstore(buf, off + 3, (val >> 24) & 255)

pub fn write_u64_le(buf: ptr<Byte>, off: Int, val: Int) with Unsafe:
    let lo: Int = val & 4294967295
    let hi: Int = (val >> 32) & 4294967295
    write_u32_le(buf, off, lo)
    write_u32_le(buf, off + 4, hi)

pub fn write_bin_file(path: String, buf: ptr<Byte>, nbytes: Int) -> Int with Unsafe:
    let h: ptr<Void> = k_open_write(path)
    if k_handle_bad(h) == 1:
        return -1
    let nslot: ptr<Int> = alloc_zeroed(1, "Int")
    let wrote: Int = k_write_all(h, nslot, buf, nbytes)
    decay nslot
    let _c: Int = k_CloseHandle(h)
    if wrote != nbytes:
        return -1
    return 0

pub fn f32_from_bits(bits: Int) -> Float with Pure:
    if bits == 0:
        return 0.0
    let sign: Int = (bits >> 31) & 1
    let exp: Int = (bits >> 23) & 255
    let mant: Int = bits & 8388607
    if exp == 0:
        return 0.0
    if exp == 255:
        if sign == 1:
            return 0.0 - 999999999.0
        return 999999999.0
    let frac: Float = 1.0 + (mant as Float) / 8388608.0
    let e: Int = exp - 127
    var scale: Float = 1.0
    if e > 0:
        var i: Int = 0
        while i < e:
            scale = scale * 2.0
            i = i + 1
    elif e < 0:
        var j: Int = 0
        while j < (0 - e):
            scale = scale / 2.0
            j = j + 1
    var val: Float = frac * scale
    if sign == 1:
        val = 0.0 - val
    return val

pub fn read_f32_le(buf: ptr<Byte>, off: Int) -> Float with Unsafe:
    let bits: Int = read_u32_le(buf, off)
    return f32_from_bits(bits)

// ── Text & String Helpers ──────────────────────────────────────────────────
pub fn str_starts_with(s: String, prefix: String) -> Int:
    let slen: Int = len(s)
    let plen: Int = len(prefix)
    if plen > slen:
        return 0
    var i: Int = 0
    while i < plen:
        if char_at(s, i) != char_at(prefix, i):
            return 0
        i = i + 1
    return 1

pub fn str_ends_with(s: String, suffix: String) -> Int:
    let slen: Int = len(s)
    let sflen: Int = len(suffix)
    if sflen > slen:
        return 0
    let off: Int = slen - sflen
    var i: Int = 0
    while i < sflen:
        if char_at(s, off + i) != char_at(suffix, i):
            return 0
        i = i + 1
    return 1

pub fn find_from(hay: String, needle: String, start: Int) -> Int:
    let hn: Int = len(hay)
    let nn: Int = len(needle)
    if nn == 0:
        return start
    var i: Int = start
    if i < 0:
        i = 0
    while i + nn <= hn:
        var j: Int = 0
        var hit: Int = 1
        while j < nn:
            if char_at(hay, i + j) != char_at(needle, j):
                hit = 0
                break
            j = j + 1
        if hit == 1:
            return i
        i = i + 1
    return -1

pub fn parse_int_text(text: String) -> Int:
    if len(text) == 0:
        return 0
    var sign: Int = 1
    var index: Int = 0
    if char_at(text, 0) == "-":
        sign = -1
        index = 1
    elif char_at(text, 0) == "+":
        index = 1
    var value: Int = 0
    while index < len(text):
        let ch: String = char_at(text, index)
        var digit: Int = 0
        if ch == "0":
            digit = 0
        elif ch == "1":
            digit = 1
        elif ch == "2":
            digit = 2
        elif ch == "3":
            digit = 3
        elif ch == "4":
            digit = 4
        elif ch == "5":
            digit = 5
        elif ch == "6":
            digit = 6
        elif ch == "7":
            digit = 7
        elif ch == "8":
            digit = 8
        elif ch == "9":
            digit = 9
        else:
            return value * sign
        value = value * 10 + digit
        index = index + 1
    return value * sign

pub fn parse_float_text(text: String) -> Float:
    if len(text) == 0:
        return 0.0
    var sign: Float = 1.0
    var index: Int = 0
    if char_at(text, 0) == "-":
        sign = 0.0 - 1.0
        index = 1
    elif char_at(text, 0) == "+":
        index = 1
    var whole: Float = 0.0
    while index < len(text):
        let ch: String = char_at(text, index)
        if ch == ".":
            break
        var digit: Float = 0.0
        if ch == "0":
            digit = 0.0
        elif ch == "1":
            digit = 1.0
        elif ch == "2":
            digit = 2.0
        elif ch == "3":
            digit = 3.0
        elif ch == "4":
            digit = 4.0
        elif ch == "5":
            digit = 5.0
        elif ch == "6":
            digit = 6.0
        elif ch == "7":
            digit = 7.0
        elif ch == "8":
            digit = 8.0
        elif ch == "9":
            digit = 9.0
        else:
            return sign * whole
        whole = whole * 10.0 + digit
        index = index + 1
    if index < len(text):
        if char_at(text, index) == ".":
            index = index + 1
            var div: Float = 10.0
            while index < len(text):
                let ch2: String = char_at(text, index)
                var d2: Float = 0.0
                if ch2 == "0":
                    d2 = 0.0
                elif ch2 == "1":
                    d2 = 1.0
                elif ch2 == "2":
                    d2 = 2.0
                elif ch2 == "3":
                    d2 = 3.0
                elif ch2 == "4":
                    d2 = 4.0
                elif ch2 == "5":
                    d2 = 5.0
                elif ch2 == "6":
                    d2 = 6.0
                elif ch2 == "7":
                    d2 = 7.0
                elif ch2 == "8":
                    d2 = 8.0
                elif ch2 == "9":
                    d2 = 9.0
                else:
                    return sign * whole
                whole = whole + d2 / div
                div = div * 10.0
                index = index + 1
    return sign * whole

pub fn format_1dp(x: Float) -> String:
    var sign: String = ""
    var v: Float = x
    if v < 0.0:
        sign = "-"
        v = 0.0 - v
    let whole: Int = v as Int
    let frac: Int = ((v - (whole as Float)) * 10.0 + 0.5) as Int
    if frac >= 10:
        return sign + str(whole + 1) + ".0"
    return sign + str(whole) + "." + str(frac)

pub fn format_2dp(x: Float) -> String:
    var sign: String = ""
    var v: Float = x
    if v < 0.0:
        sign = "-"
        v = 0.0 - v
    let whole: Int = v as Int
    let frac: Int = ((v - (whole as Float)) * 100.0 + 0.5) as Int
    if frac >= 100:
        return sign + str(whole + 1) + ".00"
    if frac < 10:
        return sign + str(whole) + ".0" + str(frac)
    return sign + str(whole) + "." + str(frac)

pub fn format_bytes(b: Int) -> String:
    if b < 1024:
        return str(b) + " B"
    if b < 1048576:
        return format_1dp((b as Float) / 1024.0) + " KB"
    if b < 1073741824:
        return format_2dp((b as Float) / 1048576.0) + " MB"
    return format_2dp((b as Float) / 1073741824.0) + " GB"

pub fn bytes_of_str(s: String) -> Array<Int>:
    let view: ByteSlice = bytes_from(s)
    return bytes_array(view)

pub fn math_sqrt(x: Float) -> Float with Pure:
    if x <= 0.0:
        return 0.0
    var g: Float = x
    if x > 1.0:
        g = x * 0.5
    var iter: Int = 0
    while iter < 12:
        g = 0.5 * (g + x / g)
        iter = iter + 1
    return g

pub fn math_abs(x: Float) -> Float with Pure:
    if x < 0.0:
        return 0.0 - x
    return x

pub fn math_sin(x: Float) -> Float with Pure:
    // Taylor series approximation around [-PI, PI]
    var y: Float = x
    while y > PI:
        y = y - TWO_PI
    while y < (0.0 - PI):
        y = y + TWO_PI
    let y2: Float = y * y
    let term3: Float = (y * y2) / 6.0
    let term5: Float = (y * y2 * y2) / 120.0
    let term7: Float = (y * y2 * y2 * y2) / 5040.0
    return y - term3 + term5 - term7

pub fn math_cos(x: Float) -> Float with Pure:
    return math_sin(x + PI * 0.5)

pub fn math_ln(x: Float) -> Float with Pure:
    if x <= 0.0:
        return 0.0 - 999999.0
    var y: Float = x
    var k: Float = 0.0
    while y > 1.41421356:
        y = y * 0.5
        k = k + 0.6931471805599453
    while y < 0.70710678:
        y = y * 2.0
        k = k - 0.6931471805599453
    let z: Float = (y - 1.0) / (y + 1.0)
    let z2: Float = z * z
    let z3: Float = z * z2
    let z5: Float = z3 * z2
    let z7: Float = z5 * z2
    let s: Float = 2.0 * (z + z3 / 3.0 + z5 / 5.0 + z7 / 7.0)
    return k + s

pub fn fp32_to_fp16(val: Float) -> Int with Pure:
    var sign: Int = 0
    var m: Float = val
    if m < 0.0:
        sign = 1
        m = 0.0 - m
    if m == 0.0:
        return sign << 15
    if m < 0.00006103515625:
        // Subnormal or underflow
        let frac: Int = (m / 0.000000059604644775390625) as Int
        return (sign << 15) | (frac & 1023)
    if m > 65504.0:
        // Overflow to inf
        return (sign << 15) | (31 << 10)

    var e: Int = 0
    while m >= 2.0:
        m = m * 0.5
        e = e + 1
    while m < 1.0:
        m = m * 2.0
        e = e - 1

    let biased_exp: Int = e + 15
    if biased_exp <= 0:
        return sign << 15
    if biased_exp >= 31:
        return (sign << 15) | (31 << 10)

    let mant: Int = ((m - 1.0) * 1024.0 + 0.5) as Int
    var final_exp: Int = biased_exp
    var final_mant: Int = mant
    if final_mant >= 1024:
        final_mant = 0
        final_exp = final_exp + 1

    return (sign << 15) | (final_exp << 10) | (final_mant & 1023)

pub fn fp16_to_fp32(u16: Int) -> Float with Pure:
    let sign: Int = (u16 >> 15) & 1
    let exp: Int = (u16 >> 10) & 31
    let mant: Int = u16 & 1023
    var sgn: Float = 1.0
    if sign == 1:
        sgn = 0.0 - 1.0

    if exp == 0:
        if mant == 0:
            return 0.0
        let frac: Float = (mant as Float) / 1024.0
        return sgn * frac * 0.00006103515625
    if exp == 31:
        return sgn * 65504.0

    let frac: Float = 1.0 + (mant as Float) / 1024.0
    let shift: Int = exp - 15
    var p2: Float = 1.0
    if shift > 0:
        var si: Int = 0
        while si < shift:
            p2 = p2 * 2.0
            si = si + 1
    elif shift < 0:
        var si: Int = 0
        let neg_shift: Int = 0 - shift
        while si < neg_shift:
            p2 = p2 * 0.5
            si = si + 1
    return sgn * frac * p2

pub fn bf16_to_fp32(u16: Int) -> Float with Pure:
    return f32_from_bits(u16 << 16)

pub fn sk_bitrev(re: ptr<Float>, im: ptr<Float>, n: Int) -> Int with Unsafe:
    var j: Int = 0
    var i: Int = 1
    while i < n:
        var bit: Int = n / 2
        while bit > 0:
            if j >= bit:
                j = j - bit
                bit = bit / 2
            else:
                break
        j = j + bit
        if i < j:
            let tr: Float = mem_load(ptr_offset(re, i, "Float"), "Float")
            let ti: Float = mem_load(ptr_offset(im, i, "Float"), "Float")
            mem_store(ptr_offset(re, i, "Float"), mem_load(ptr_offset(re, j, "Float"), "Float"), "Float")
            mem_store(ptr_offset(im, i, "Float"), mem_load(ptr_offset(im, j, "Float"), "Float"), "Float")
            mem_store(ptr_offset(re, j, "Float"), tr, "Float")
            mem_store(ptr_offset(im, j, "Float"), ti, "Float")
        i = i + 1
    return 0

pub fn sk_fft(re: ptr<Float>, im: ptr<Float>, n: Int) -> Int with Unsafe:
    let _b: Int = sk_bitrev(re, im, n)
    var size: Int = 2
    while size <= n:
        let half_size: Int = size / 2
        let step: Float = (0.0 - TWO_PI) / (size as Float)
        var i: Int = 0
        while i < n:
            var k: Int = 0
            var j: Int = i
            while j < i + half_size:
                let ang: Float = (k as Float) * step
                let cw: Float = math_cos(ang)
                let sw: Float = math_sin(ang)
                let ar: Float = mem_load(ptr_offset(re, j + half_size, "Float"), "Float")
                let ai: Float = mem_load(ptr_offset(im, j + half_size, "Float"), "Float")
                let tpre: Float = cw * ar - sw * ai
                let tpim: Float = sw * ar + cw * ai
                let xr: Float = mem_load(ptr_offset(re, j, "Float"), "Float")
                let xi: Float = mem_load(ptr_offset(im, j, "Float"), "Float")
                mem_store(ptr_offset(re, j, "Float"), xr + tpre, "Float")
                mem_store(ptr_offset(im, j, "Float"), xi + tpim, "Float")
                mem_store(ptr_offset(re, j + half_size, "Float"), xr - tpre, "Float")
                mem_store(ptr_offset(im, j + half_size, "Float"), xi - tpim, "Float")
                k = k + 1
                j = j + 1
            i = i + size
        size = size * 2
    return 0

// ============================================================================
// bispectrum_lens.kn
// ============================================================================
// ============================================================================
// bispectrum_lens.kn — Lens 3: Bispectral Analysis & Quadratic Phase Coupling (QPC)
//
// Higher-Order Spectral Analysis (HOSA) over cross-attention and modulation layers:
//   Kim & Powers (1979) Normalized Bicoherence (b^2) across the Irreducible
//   Principal Domain (IRPD), Quadratic Phase Coupling (QPC), and Intermodulation
//   Distortion detection.
//
// Distinguishes coherent feature binding from hallucination noise.
// Ported & adapted from TurboKain bispectrum.kn.
// ============================================================================

use std::runtime
use std::text

pub struct BispectrumVerdict:
    block_idx: Int
    bicoherence_sq: Float
    qpc_phase_coherence: Float
    distortion_ratio: Float
    verdict: String

// 8-point DFT for micro triad estimation fallback
pub fn dft8_real(signal: Array<Float>, k: Int) -> Float:
    var sum: Float = 0.0
    var n: Int = 0
    let slen: Int = len(signal)
    while n < 8:
        let angle: Float = (TWO_PI * (k as Float) * (n as Float)) / 8.0
        sum = sum + signal[n % slen] * math_cos(angle)
        n = n + 1
    return sum

pub fn dft8_imag(signal: Array<Float>, k: Int) -> Float:
    var sum: Float = 0.0
    var n: Int = 0
    let slen: Int = len(signal)
    while n < 8:
        let angle: Float = (TWO_PI * (k as Float) * (n as Float)) / 8.0
        sum = sum - signal[n % slen] * math_sin(angle)
        n = n + 1
    return sum

// Converge kernels for cross-triad bispectrum accumulation
fn bisp_term_re_spec(r1: Float, i1: Float, r2: Float, i2: Float, r3: Float, i3: Float) -> Float with Pure:
    let ar: Float = r1 * r2 - i1 * i2
    let ai: Float = r1 * i2 + i1 * r2
    return ar * r3 + ai * i3

converge bisp_term_re(r1: Float, i1: Float, r2: Float, i2: Float, r3: Float, i3: Float) -> Float:
    spec reference:
        return bisp_term_re_spec(r1, i1, r2, i2, r3, i3)
    fast branchless_lane:
        return bisp_term_re_spec(r1, i1, r2, i2, r3, i3)
    verify random(8)

fn bisp_term_im_spec(r1: Float, i1: Float, r2: Float, i2: Float, r3: Float, i3: Float) -> Float with Pure:
    let ar: Float = r1 * r2 - i1 * i2
    let ai: Float = r1 * i2 + i1 * r2
    return ai * r3 - ar * i3

converge bisp_term_im(r1: Float, i1: Float, r2: Float, i2: Float, r3: Float, i3: Float) -> Float:
    spec reference:
        return bisp_term_im_spec(r1, i1, r2, i2, r3, i3)
    fast branchless_lane:
        return bisp_term_im_spec(r1, i1, r2, i2, r3, i3)
    verify random(8)

// Full IRPD (Irreducible Principal Domain) Kim & Powers 1979 Normalized Bicoherence Engine
pub fn evaluate_bispectrum_block(block_idx: Int, sample: Array<Float>) -> BispectrumVerdict with Unsafe:
    let n_total: Int = len(sample)
    if n_total < 16:
        return BispectrumVerdict {
            block_idx: block_idx,
            bicoherence_sq: 0.5,
            qpc_phase_coherence: 0.5,
            distortion_ratio: 0.1,
            verdict: "INSUFFICIENT DATA",
        }

    let n_fft: Int = 16
    let k_max: Int = n_fft / 2 // 8 bins
    let m_blocks: Int = n_total / n_fft
    if m_blocks <= 0:
        return BispectrumVerdict {
            block_idx: block_idx,
            bicoherence_sq: 0.0,
            qpc_phase_coherence: 0.0,
            distortion_ratio: 0.5,
            verdict: "WEAK PHASE COUPLING",
        }

    // Segment FFT buffers
    let spec_sz: Int = m_blocks * (k_max + 1)
    let spec_r: ptr<Float> = alloc_zeroed(spec_sz + 32, "Float")
    let spec_i: ptr<Float> = alloc_zeroed(spec_sz + 32, "Float")
    let spec_p: ptr<Float> = alloc_zeroed(spec_sz + 32, "Float")

    let fft_r: ptr<Float> = alloc_zeroed(n_fft + 32, "Float")
    let fft_i: ptr<Float> = alloc_zeroed(n_fft + 32, "Float")

    // 1. Compute Hann-windowed FFTs across segments
    var blk: Int = 0
    while blk < m_blocks:
        let in_off: Int = blk * n_fft
        var wi: Int = 0
        while wi < n_fft:
            let w_val: Float = 0.5 * (1.0 - math_cos((TWO_PI * (wi as Float)) / (n_fft as Float)))
            let s_val: Float = sample[in_off + wi] * w_val
            mem_store(ptr_offset(fft_r, wi, "Float"), s_val, "Float")
            mem_store(ptr_offset(fft_i, wi, "Float"), 0.0, "Float")
            wi = wi + 1

        let _f: Int = sk_fft(fft_r, fft_i, n_fft)

        var k: Int = 0
        while k <= k_max:
            let r: Float = mem_load(ptr_offset(fft_r, k, "Float"), "Float")
            let im: Float = mem_load(ptr_offset(fft_i, k, "Float"), "Float")
            let p: Float = r * r + im * im
            let dst_off: Int = blk * (k_max + 1) + k
            mem_store(ptr_offset(spec_r, dst_off, "Float"), r, "Float")
            mem_store(ptr_offset(spec_i, dst_off, "Float"), im, "Float")
            mem_store(ptr_offset(spec_p, dst_off, "Float"), p, "Float")
            k = k + 1
        blk = blk + 1

    decay fft_r
    decay fft_i

    // 2. Scan IRPD domain: 0 <= k2 <= k1, k1 + k2 <= k_max
    var max_b2: Float = 0.0
    var total_coupled_power: Float = 0.0
    var total_spectral_power: Float = 0.0

    var k1: Int = 1
    while k1 < k_max:
        var k2: Int = 1
        while k2 <= k1:
            let k3: Int = k1 + k2
            if k3 <= k_max:
                // Accumulate bispectrum over m_blocks
                var sum_re: Float = 0.0
                var sum_im: Float = 0.0
                var d12: Float = 0.0
                var d3: Float = 0.0

                var m: Int = 0
                while m < m_blocks:
                    let stride: Int = k_max + 1
                    let off1: Int = m * stride + k1
                    let off2: Int = m * stride + k2
                    let off3: Int = m * stride + k3

                    let r1: Float = mem_load(ptr_offset(spec_r, off1, "Float"), "Float")
                    let i1: Float = mem_load(ptr_offset(spec_i, off1, "Float"), "Float")
                    let r2: Float = mem_load(ptr_offset(spec_r, off2, "Float"), "Float")
                    let i2: Float = mem_load(ptr_offset(spec_i, off2, "Float"), "Float")
                    let r3: Float = mem_load(ptr_offset(spec_r, off3, "Float"), "Float")
                    let i3: Float = mem_load(ptr_offset(spec_i, off3, "Float"), "Float")

                    let p1: Float = mem_load(ptr_offset(spec_p, off1, "Float"), "Float")
                    let p2: Float = mem_load(ptr_offset(spec_p, off2, "Float"), "Float")
                    let p3: Float = mem_load(ptr_offset(spec_p, off3, "Float"), "Float")

                    let tre: Float = bisp_term_re(r1, i1, r2, i2, r3, i3)
                    let tim: Float = bisp_term_im(r1, i1, r2, i2, r3, i3)

                    sum_re = sum_re + tre
                    sum_im = sum_im + tim
                    d12 = d12 + p1 * p2
                    d3 = d3 + p3

                    total_spectral_power = total_spectral_power + p1 + p2 + p3
                    m = m + 1

                let den: Float = d12 * d3
                if den > 0.000000000001:
                    let num_sq: Float = sum_re * sum_re + sum_im * sum_im
                    var b2: Float = num_sq / den
                    if b2 > 1.0: b2 = 1.0
                    if b2 > max_b2:
                        max_b2 = b2
                    if b2 > 0.15:
                        total_coupled_power = total_coupled_power + math_sqrt(num_sq)
            k2 = k2 + 1
        k1 = k1 + 1

    decay spec_r
    decay spec_i
    decay spec_p

    var dist_ratio: Float = 0.0
    if total_spectral_power > 0.000001:
        dist_ratio = 1.0 - (total_coupled_power / total_spectral_power)
        if dist_ratio < 0.0: dist_ratio = 0.0
        if dist_ratio > 1.0: dist_ratio = 1.0

    var v: String = "HARMONIC LOCK (Clean)"
    if max_b2 < 0.05 and dist_ratio > 0.35:
        v = "HIGH INTERMODULATION DISTORTION"
    elif max_b2 < 0.12:
        v = "WEAK PHASE COUPLING"

    return BispectrumVerdict {
        block_idx: block_idx,
        bicoherence_sq: max_b2,
        qpc_phase_coherence: math_sqrt(max_b2),
        distortion_ratio: dist_ratio,
        verdict: v,
    }

// ============================================================================
// dispatch.kn
// ============================================================================
// ============================================================================
// dispatch.kn — juicer.kn Unified CLI Dispatcher & Master Entry Point
//
// Commands:
//   juicer profile <model.gguf>               DSP Harmonic & Entropy Redundancy Profile
//   juicer slice <model.gguf> --drop <list>   Zero-Copy Physical Layer Excision & Rewriter
//   juicer schedule <model.gguf> --steps <N>  Dynamic Step-Adaptive Layer Skipping JSON
//   juicer prove                              7-Instrument Formal Verification Battery
//   juicer help                               Operational Handbook
// ============================================================================

use std::runtime
use std::text
use std::bytes
use std::process

fn print_banner():
    println("================================================================================")
    println(" juicer.kn v0.1.0 — DSP Post-Training Model Pruner & Harmonic Squeezer")
    println(" Squeeze the bloat out of models. Pure juice. Zero flab.")
    println("================================================================================")

fn print_usage():
    print_banner()
    println("\nUSAGE:")
    println("  juicer <command> [options...]")
    println("  jc <command> [options...]\n")
    println("COMMANDS:")
    println("  profile <model.gguf>                   Scan GGUF weights via 4 DSP lenses")
    println("                                         Outputs layer transfer functions & idling report")
    println("  fuse <model.gguf> <lora.safetensors> [--strength 1.0] [--drop <list>] --out <fused.gguf>")
    println("                                         Bake LoRA directly into model weights via CUDA")
    println("                                         (Optionally slice/drop blocks in the same pass)")
    println("  slice <model.gguf> --drop <list> --out <out.gguf>")
    println("                                         Physically excise dead layers & rewrite GGUF")
    println("                                         (e.g. --drop 18,19,23,24 --out wan2.1-11b.gguf)")
    println("  quantize <model.gguf> [--type q8_0|q4_0] --out <out.gguf>")
    println("                                         Native AVX2 GGUF block quantization & compression")
    println("  schedule <model.gguf> --steps 4 --out <recipe.json>")
    println("                                         Emit dynamic step-skipping recipe for ComfyUI")
    println("  prove                                  Run 8-point in-memory formal verification battery")
    println("  help                                   Show this handbook\n")
    println("EXAMPLES:")
    println("  juicer profile models/diffusion_models/wan2.1-i2v-14b-480p-Q4_K_M.gguf")
    println("  juicer fuse wan2.1-14b.gguf models/loras/lightning_4step.safetensors --out wan2.1-lightning.gguf")
    println("  juicer fuse wan2.1-14b.gguf models/loras/lightning_4step.safetensors --drop 18,19,20,21 --out wan2.1-fast-36b.gguf")
    println("  juicer slice wan2.1-14b.gguf --drop 18,19,22,23,24,25,28,29 --out wan2.1-11.2b.gguf")
    println("  juicer schedule wan2.1-14b.gguf --steps 4 --out wan_step_recipe.json\n")

fn parse_comma_int_list(csv: String) -> Array<Int>:
    var list: Array<Int> = []
    var cur: String = ""
    var i: Int = 0
    while i < len(csv):
        let c: String = char_at(csv, i)
        if c == "," or c == " " or c == ";":
            if len(cur) > 0:
                push(list, parse_int_text(cur))
                cur = ""
        else:
            cur = cur + c
        i = i + 1
    if len(cur) > 0:
        push(list, parse_int_text(cur))
    return list

fn run_profile_command(model_path: String) -> Int with Unsafe:
    if str_ends_with(model_path, ".safetensors") == 1:
        return run_safetensors_profile_command(model_path)

    print_banner()
    println(" [Stage 1/2] Streaming GGUF Tensor Index via kernel32 DMA ...")
    let model: GgufModel = parse_gguf_model(model_path)
    if model.file_size <= 0:
        println("profile: failed to load model " + model_path)
        return EXIT_ERROR

    println(" Loaded:       " + model_path)
    println(" Architecture: " + model.arch)
    println(" File Size:    " + format_bytes(model.file_size))
    println(" Tensors:      " + str(model.tensor_count))
    println(" Blocks:       " + str(model.block_count))
    println(" Alignment:    " + str(model.alignment) + " bytes")
    println(" Data Offset:  " + str(model.tensor_data_offset) + " bytes")

    println("\n [Stage 2/2] Deploying 4 DSP Analytical Lenses across " + str(model.block_count) + " blocks ...")
    println("---------------------------------------------------------------------------------------------------")
    println(" BLK |  SIZE   | SPECTRAL GAIN | CONDITION | KURTOSIS | PERM ENT | VELOCITY | BICOHERENCE | VERDICT")
    println("---------------------------------------------------------------------------------------------------")

    let h_weights: ptr<Void> = k_open_read(model_path)
    if k_handle_bad(h_weights) == 1:
        println("profile: failed to open model for weight streaming: " + model_path)
        return EXIT_ERROR

    var prunable_blocks: Array<Int> = []
    var prunable_bytes: Int = 0
    var prev_h: Float = 0.0 - 1.0

    var bi: Int = 0
    while bi < len(model.blocks):
        let blk: GgufBlock = model.blocks[bi]
        
        // Stream real weights from disk via kernel32 DMA
        var sample: Array<Float> = read_block_weight_sample(h_weights, model, blk.block_idx, 256)
        if len(sample) < 16:
            var si: Int = 0
            while si < 64:
                push(sample, 0.0)
                si = si + 1

        let spec: SpectralVerdict = evaluate_spectral_block(blk.block_idx, sample, 16)
        let ent: EntropyVerdict = evaluate_entropy_block(blk.block_idx, prev_h, sample)
        let bisp: BispectrumVerdict = evaluate_bispectrum_block(blk.block_idx, sample)
        prev_h = ent.perm_entropy

        // Formatting block row
        var row: String = " "
        if blk.block_idx < 10:
            row = row + " "
        row = row + str(blk.block_idx) + " | "
        
        let sz_str: String = format_bytes(blk.total_bytes)
        row = row + sz_str
        var pad: Int = 8 - len(sz_str)
        while pad > 0:
            row = row + " "
            pad = pad - 1
        row = row + " | "

        let g_str: String = format_1dp(spec.delta_gain_db) + " dB"
        row = row + g_str
        pad = 13 - len(g_str)
        while pad > 0:
            row = row + " "
            pad = pad - 1
        row = row + " | "

        let k_str: String = format_2dp(spec.condition_number)
        row = row + k_str
        pad = 9 - len(k_str)
        while pad > 0:
            row = row + " "
            pad = pad - 1
        row = row + " | "

        let kurt_str: String = format_1dp(spec.kurtosis)
        row = row + kurt_str
        pad = 8 - len(kurt_str)
        while pad > 0:
            row = row + " "
            pad = pad - 1
        row = row + " | "

        let h_str: String = format_2dp(ent.perm_entropy)
        row = row + h_str
        pad = 8 - len(h_str)
        while pad > 0:
            row = row + " "
            pad = pad - 1
        row = row + " | "

        let v_str: String = format_2dp(ent.entropy_velocity)
        row = row + v_str
        pad = 8 - len(v_str)
        while pad > 0:
            row = row + " "
            pad = pad - 1
        row = row + " | "

        let b2_str: String = format_2dp(bisp.bicoherence_sq)
        row = row + b2_str
        pad = 11 - len(b2_str)
        while pad > 0:
            row = row + " "
            pad = pad - 1
        row = row + " | "

        var verdict_str: String = "ACTIVE"
        if spec.kurtosis > 8.0:
            verdict_str = "PROTECTED (Outlier)"
        elif spec.is_all_pass == 1 or ent.is_idling == 1:
            verdict_str = "EXCISE (Candidate)"
            push(prunable_blocks, blk.block_idx)
            prunable_bytes = prunable_bytes + blk.total_bytes
        elif spec.delta_gain_db < (0.0 - 15.0):
            verdict_str = "LOW_ENERGY"
        elif bisp.verdict == "HIGH INTERMODULATION DISTORTION":
            verdict_str = "NOISY (High IMD)"

        row = row + verdict_str
        println(row)

        bi = bi + 1

    let _c_w: Int = k_CloseHandle(h_weights)

    println("---------------------------------------------------------------------------------------------------")
    println("\n JUICER SUMMARY & ACTIONABLE RECIPE:")
    println(" Redundant Blocks Found:  " + str(len(prunable_blocks)) + " / " + str(model.block_count))
    if len(prunable_blocks) > 0:
        var drop_arg: String = ""
        var pi: Int = 0
        while pi < len(prunable_blocks):
            if pi > 0:
                drop_arg = drop_arg + ","
            drop_arg = drop_arg + str(prunable_blocks[pi])
            pi = pi + 1
        println(" Recommended --drop List: " + drop_arg)
        println(" Est. VRAM Reclaimed:     " + format_bytes(prunable_bytes) + " (" + format_1dp(((prunable_bytes as Float) / (model.file_size as Float)) * 100.0) + "% reduction)")
        let target_sz: Int = model.file_size - prunable_bytes
        println(" Sliced Model Footprint:  " + format_bytes(target_sz))
        println("\n Next Step -> Run Physical Slicer:")
        println("   juicer slice " + model_path + " --drop " + drop_arg + " --out juiced_model.gguf\n")
    else:
        println(" Model is already tightly optimized (all blocks actively transforming latent geometry).")

    return EXIT_OK

fn run_safetensors_profile_command(model_path: String) -> Int with Unsafe:
    print_banner()
    println(" [Stage 1/2] Streaming SafeTensors Directory via kernel32 DMA ...")
    let model: SafetensorsModel = parse_safetensors_model(model_path)
    if model.file_size <= 0:
        println("profile: failed to load safetensors model " + model_path)
        return EXIT_ERROR

    println(" Loaded:       " + model_path)
    println(" Format:       Raw Master Weights (Zero Quantization Artifacts)")
    println(" File Size:    " + format_bytes(model.file_size))

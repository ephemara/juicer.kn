    println(" Tensors:      " + str(model.tensor_count))
    println(" Blocks:       " + str(model.block_count))
    println(" Data Offset:  " + str(model.data_offset) + " bytes")

    println("\n [Stage 2/2] Deploying 4 DSP Analytical Lenses across " + str(model.block_count) + " blocks (Raw Floats) ...")
    println("---------------------------------------------------------------------------------------------------")
